APP_NAME="Club Sportif Teranga"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Dakar
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ----------------------------------------------------------------
# Base de donnees PostgreSQL
# Sous Laragon / pgAdmin, le port par defaut est 5432.
# ----------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=teranga
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=sync

# ----------------------------------------------------------------
# Sanctum / CORS
# SANCTUM_STATEFUL_DOMAINS et FRONTEND_URL doivent pointer vers
# l'application Angular (ng serve ecoute sur le port 4200).
# ----------------------------------------------------------------
FRONTEND_URL=http://localhost:4200
SANCTUM_STATEFUL_DOMAINS=localhost:4200
